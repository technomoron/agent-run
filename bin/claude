#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/agent-wrapper-common.sh"

REAL_CLAUDE=$(find_real_binary "claude" "$SCRIPT_PATH")
CLAUDE_PERMISSION_ARGS=""
CLAUDE_BYPASS_AGENT_SETUP=0
CLAUDE_CREATE_AGENT_FILES=0
FILTERED_CLAUDE_ARGS=""

filter_claude_wrapper_args() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--none)
				CLAUDE_BYPASS_AGENT_SETUP=1
				;;
			--create)
				CLAUDE_CREATE_AGENT_FILES=1
				;;
			*)
				quoted_arg=$(printf "%s" "$1" | sed "s/'/'\\\\''/g")
				FILTERED_CLAUDE_ARGS="$FILTERED_CLAUDE_ARGS '$quoted_arg'"
				;;
		esac
		shift
	done
}

filter_claude_wrapper_args "$@"
eval "set --$FILTERED_CLAUDE_ARGS"

if is_force_permissive; then
	if is_root_user; then
		debug_log "force permissive requested, but skipped for root claude session"
	else
		debug_log "force permissive enabled for claude"
		CLAUDE_PERMISSION_ARGS="--permission-mode bypassPermissions"
	fi
else
	debug_log "using default claude permission mode"
fi

if [ "$CLAUDE_BYPASS_AGENT_SETUP" = "1" ]; then
	exec "$REAL_CLAUDE" $CLAUDE_PERMISSION_ARGS "$@"
fi

if use_local_ai_files; then
	exec "$REAL_CLAUDE" $CLAUDE_PERMISSION_ARGS "$@"
fi

AGENT_DIR=$(resolve_agent_dir)

if [ "$CLAUDE_CREATE_AGENT_FILES" = "1" ]; then
	create_blank_agent_files "$AGENT_DIR"
	printf 'agent-wrapper: created blank agent files in %s\n' "$AGENT_DIR" >&2
fi

if [ -f "$AGENT_DIR/AGENTS-MODS.md" ] || [ -f "$AGENT_DIR/AGENTS.md" ]; then
	RUNTIME_DIR=$(materialize_agent_runtime_dir "$AGENT_DIR")
	trap 'rm -rf "$RUNTIME_DIR"' EXIT INT TERM

	exec "$REAL_CLAUDE" \
		$CLAUDE_PERMISSION_ARGS \
		--add-dir "$RUNTIME_DIR" \
		"$@"
fi

if [ -f "$AGENT_DIR/CLAUDE.md" ]; then
	exec "$REAL_CLAUDE" \
		$CLAUDE_PERMISSION_ARGS \
		--add-dir "$AGENT_DIR" \
		"$@"
fi

printf 'agent-wrapper: no claude config found for this project: %s\n' "$AGENT_DIR" >&2
printf 'agent-wrapper: run `claude --none` to bypass agent setup, or `claude --create` to create blank agent files.\n' >&2
exit 1
