#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/agent-wrapper-common.sh"

REAL_CODEX=$(find_real_binary "codex" "$SCRIPT_PATH")
CODEX_PERMISSION_ARGS=""
CODEX_BYPASS_AGENT_SETUP=0
CODEX_CREATE_AGENT_FILES=0
FILTERED_CODEX_ARGS=""

filter_codex_wrapper_args() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--none)
				CODEX_BYPASS_AGENT_SETUP=1
				;;
			--create)
				CODEX_CREATE_AGENT_FILES=1
				;;
			*)
				quoted_arg=$(printf "%s" "$1" | sed "s/'/'\\\\''/g")
				FILTERED_CODEX_ARGS="$FILTERED_CODEX_ARGS '$quoted_arg'"
				;;
		esac
		shift
	done
}

filter_codex_wrapper_args "$@"
eval "set --$FILTERED_CODEX_ARGS"

if is_force_permissive; then
	debug_log "force permissive enabled for codex"
	CODEX_PERMISSION_ARGS="-a never -s danger-full-access"
else
	debug_log "using default codex approval and sandbox modes"
fi

if [ "$CODEX_BYPASS_AGENT_SETUP" = "1" ]; then
	exec "$REAL_CODEX" $CODEX_PERMISSION_ARGS "$@"
fi

if use_local_ai_files; then
	exec "$REAL_CODEX" $CODEX_PERMISSION_ARGS "$@"
fi

AGENT_DIR=$(resolve_agent_dir)

if [ "$CODEX_CREATE_AGENT_FILES" = "1" ]; then
	create_blank_agent_files "$AGENT_DIR"
	printf 'agent-wrapper: created blank agent files in %s\n' "$AGENT_DIR" >&2
fi

if [ -f "$AGENT_DIR/AGENTS-MODS.md" ] || [ -f "$AGENT_DIR/AGENTS.md" ]; then
	RUNTIME_DIR=$(materialize_agent_runtime_dir "$AGENT_DIR")
	trap 'rm -rf "$RUNTIME_DIR"' EXIT INT TERM

	exec "$REAL_CODEX" \
		$CODEX_PERMISSION_ARGS \
		--config "system_prompt_file=\"$RUNTIME_DIR/AGENTS.md\"" \
		"$@"
fi

printf 'agent-wrapper: no codex config found for this project: %s\n' "$AGENT_DIR" >&2
printf 'agent-wrapper: run `codex --none` to bypass agent setup, or `codex --create` to create blank agent files.\n' >&2
exit 1
