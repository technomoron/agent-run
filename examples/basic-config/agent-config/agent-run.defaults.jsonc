{
  // Shared defaults; profile manifests contain only differences.
  "kind": "code",
  "agent": {
    "default": "codex",
    "base": "global/agents/code.md.njk",
    "includes": [
      "{{ profile }}/local.md.njk"
    ]
  },
  "skills": {
    "install": [
      "commit-workflow",
      "github-release",
      "release-package-check",
      "code-review-organizer"
    ]
  },
  "tools": {
    "codex": true,
    "claude": true,
    "gemini": true,
    "grok": true
  },
  "mcp": {
    "servers": {}
  },
  "checks": [
    "agent-run check .",
    "pnpm run cleanbuild"
  ],
  "guardrails": {
    "blockGitWrite": true,
    "blockPublish": true,
    "blockGithubRelease": true,
    "forbidRepoAiFiles": true
  },
  "paths": {
    "changesFile": "{{ projectRoot }}/CHANGES",
    "reviewDir": "{{ profileDir }}/reviews",
    "reviewFile": "{{ profileDir }}/reviews/REVIEW-{{ date }}.md",
    "memoriesDir": "{{ agentDir }}/memories",
    "projectMemoryDir": "{{ profileDir }}/notes/memory"
  }
}
