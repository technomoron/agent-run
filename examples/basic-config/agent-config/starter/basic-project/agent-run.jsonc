{
  "agent": {
    "includes": [
      "{{ profile }}/local.md.njk",
      "{{ profile }}/project-rules.md.njk"
    ]
  },
  "skills": {
    "install": [
      "commit-workflow",
      "github-release",
      "release-package-check",
      "code-review-organizer",
      "triage"
    ],
    "overrides": {
      "triage": "{{ profile }}/overrides/triage.SKILL.md.njk"
    }
  },
  "mcp": {
    "servers": {
      "example-stdio": {
        "command": "node",
        "args": ["tools/example-mcp.js"],
        "env": {
          "EXAMPLE_TOKEN": "${EXAMPLE_TOKEN}"
        },
        "enabled": false
      },
      "example-http": {
        "transport": "http",
        "url": "https://example.invalid/mcp",
        "headers": {
          "Authorization": "Bearer ${EXAMPLE_TOKEN}"
        },
        "enabled": false
      }
    }
  },
  "checks": [
    "agent-run check .",
    "pnpm test"
  ]
}
