// Save as ~/.agent-run/brain.jsonc, then run agent-run brain-login.
// No configuration Git checkout or agent-run setup step is needed.
// First launch creates projects/<owner>/<repo>/ and its generated live/ files.
// Existing custom launcher settings and templates are preserved.
{
  "enabled": true,
  "remote": {
    "url": "https://brain.example.com/mcp",
    "clientId": "registered-desktop-client",
    "redirectUrl": "http://127.0.0.1:8123/callback",
    "scope": "read write review repo:*"
  }
}
