{
  "name": "@technomoron/agent-run",
  "version": "0.99.33",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "agent-run": "dist/agent-run.js",
    "agent-brain": "dist/agent-brain.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/",
    "examples/",
    "ops/",
    "scripts/agent-config-login-warning.sh",
    "scripts/install-systemd-jobs.sh",
    "scripts/update-ai-tools.sh",
    "scripts/ensure-agent-brain.sh",
    "README.md",
    "LICENSE",
    "CHANGES"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technomoron/agent-run.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"for (const bin of ['agent-run', 'agent-brain']) require('node:fs').chmodSync('dist/' + bin + '.js', 0o755)\"",
    "clean:dist": "rimraf ./dist/",
    "cleanbuild": "run-s clean:dist build",
    "prepack": "run-s build",
    "test": "run-s build test:integration test:release",
    "test:brain": "node --test scripts/test-brain.cjs",
    "test:integration": "bash ./scripts/test.sh",
    "test:release": "bash ./scripts/test-release.sh",
    "release": "bash ./scripts/release.sh",
    "release:preflight": "pnpm cleanbuild && pnpm test",
    "release:verify": "bash ./scripts/release-verify.sh"
  },
  "author": "Bjorn Erik Jacobsen",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Bjørn Erik Jacobsen / Technomoron.com",
  "bugs": {
    "url": "https://github.com/technomoron/agent-run/issues"
  },
  "homepage": "https://github.com/technomoron/agent-run#readme",
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "@types/nunjucks": "^3.2.6",
    "npm-run-all": "^4.1.5",
    "pnpm": "10.34.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@technomoron/apicore-server": "^1.0.0",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
